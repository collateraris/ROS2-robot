<?xml version="1.0"?>
<package format="3">
  <name>roomwm_msgs</name>
  <version>0.2.0</version>
  <description>Typed observation, current geometry, pulse and task interfaces for Room World Model v2.</description>
  <maintainer email="maintainer@example.invalid">Room robot project</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>action_msgs</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
