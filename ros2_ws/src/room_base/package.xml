<?xml version="1.0"?>
<package format="3">
  <name>room_base</name><version>0.4.0</version>
  <description>Guarded RF2O laser odometry and calibrated encoderless serial PWM bridge.</description>
  <maintainer email="robot@example.invalid">Room robot project</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>python3-serial</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
