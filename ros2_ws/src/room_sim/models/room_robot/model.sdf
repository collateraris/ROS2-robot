<?xml version="1.0"?>
<!-- Native Gazebo Harmonic SDF. Operational odometry comes ONLY from RF2O. -->
<sdf version="1.9"><model name="room_robot" canonical_link="base_link">
  <self_collide>false</self_collide>
  <!-- Model origin = base_link at axle plane. Spawn z=0.034: radius 0.033 + 1 mm. -->
  <link name="base_link">
    <inertial><pose>0 0 0.02 0 0 0</pose><mass>1.6</mass>
      <inertia><ixx>0.004186667</ixx><iyy>0.008013333</iyy><izz>0.011533333</izz></inertia></inertial>
    <collision name="chassis_collision"><pose>0 0 .02 0 0 0</pose><geometry><box><size>.24 .17 .05</size></box></geometry></collision><visual name="chassis_visual"><pose>0 0 .02 0 0 0</pose><geometry><box><size>.24 .17 .05</size></box></geometry>
      <material><ambient>.18 .42 .22 1</ambient><diffuse>.18 .42 .22 1</diffuse></material></visual>
    <collision name="bumper_collision"><pose>0 0 .015 0 0 0</pose><geometry><box><size>.27 .25 .025</size></box></geometry></collision><visual name="bumper_visual"><pose>0 0 .015 0 0 0</pose><geometry><box><size>.27 .25 .025</size></box></geometry>
      <material><ambient>.11 .12 .13 1</ambient><diffuse>.11 .12 .13 1</diffuse></material></visual>
    <visual name="battery_visual"><pose>-.035 0 .057 0 0 0</pose><geometry><box><size>.11 .065 .025</size></box></geometry>
      <material><ambient>.12 .12 .15 1</ambient><diffuse>.12 .12 .15 1</diffuse></material></visual>
    <visual name="compute_visual"><pose>.065 0 .058 0 0 0</pose><geometry><box><size>.07 .055 .012</size></box></geometry>
      <material><ambient>.05 .32 .14 1</ambient><diffuse>.05 .32 .14 1</diffuse></material></visual>
    <sensor name="bumper_contact" type="contact">
      <always_on>true</always_on><update_rate>100</update_rate>
      <contact><collision>bumper_collision</collision><topic>/sim/contacts</topic></contact>
    </sensor>
  </link>
  <link name="front_left_wheel">
      <pose relative_to="base_link">0.085 0.105 0 0 0 0</pose>
      <inertial><mass>0.06</mass><inertia><ixx>0.00001946</ixx><iyy>0.00003267</iyy><izz>0.00001946</izz></inertia></inertial>
      <collision name="front_left_wheel_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="front_left_wheel_visual"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry><material><ambient>.04 .045 .05 1</ambient><diffuse>.04 .045 .05 1</diffuse></material></visual>
      <!-- Real wheel/ground contacts keep the contact stream observable on clean runs.
           Each sensor references only its own link's collision; no synthetic heartbeat. -->
      <sensor name="front_left_wheel_contact" type="contact">
        <always_on>true</always_on><update_rate>20</update_rate>
        <contact><collision>front_left_wheel_collision</collision><topic>/sim/contacts</topic></contact>
      </sensor>
    </link><link name="front_right_wheel">
      <pose relative_to="base_link">0.085 -0.105 0 0 0 0</pose>
      <inertial><mass>0.06</mass><inertia><ixx>0.00001946</ixx><iyy>0.00003267</iyy><izz>0.00001946</izz></inertia></inertial>
      <collision name="front_right_wheel_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="front_right_wheel_visual"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry><material><ambient>.04 .045 .05 1</ambient><diffuse>.04 .045 .05 1</diffuse></material></visual>
      <!-- Real wheel/ground contacts keep the contact stream observable on clean runs.
           Each sensor references only its own link's collision; no synthetic heartbeat. -->
      <sensor name="front_right_wheel_contact" type="contact">
        <always_on>true</always_on><update_rate>20</update_rate>
        <contact><collision>front_right_wheel_collision</collision><topic>/sim/contacts</topic></contact>
      </sensor>
    </link><link name="rear_left_wheel">
      <pose relative_to="base_link">-0.085 0.105 0 0 0 0</pose>
      <inertial><mass>0.06</mass><inertia><ixx>0.00001946</ixx><iyy>0.00003267</iyy><izz>0.00001946</izz></inertia></inertial>
      <collision name="rear_left_wheel_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="rear_left_wheel_visual"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry><material><ambient>.04 .045 .05 1</ambient><diffuse>.04 .045 .05 1</diffuse></material></visual>
      <!-- Real wheel/ground contacts keep the contact stream observable on clean runs.
           Each sensor references only its own link's collision; no synthetic heartbeat. -->
      <sensor name="rear_left_wheel_contact" type="contact">
        <always_on>true</always_on><update_rate>20</update_rate>
        <contact><collision>rear_left_wheel_collision</collision><topic>/sim/contacts</topic></contact>
      </sensor>
    </link><link name="rear_right_wheel">
      <pose relative_to="base_link">-0.085 -0.105 0 0 0 0</pose>
      <inertial><mass>0.06</mass><inertia><ixx>0.00001946</ixx><iyy>0.00003267</iyy><izz>0.00001946</izz></inertia></inertial>
      <collision name="rear_right_wheel_collision"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="rear_right_wheel_visual"><pose>0 0 0 1.5707963267948966 0 0</pose><geometry><cylinder><radius>0.033</radius><length>0.025</length></cylinder></geometry><material><ambient>.04 .045 .05 1</ambient><diffuse>.04 .045 .05 1</diffuse></material></visual>
      <!-- Real wheel/ground contacts keep the contact stream observable on clean runs.
           Each sensor references only its own link's collision; no synthetic heartbeat. -->
      <sensor name="rear_right_wheel_contact" type="contact">
        <always_on>true</always_on><update_rate>20</update_rate>
        <contact><collision>rear_right_wheel_collision</collision><topic>/sim/contacts</topic></contact>
      </sensor>
    </link>
  <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>2</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.002</damping><friction>0</friction></dynamics>
      </axis></joint><joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>2</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.002</damping><friction>0</friction></dynamics>
      </axis></joint><joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>2</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.002</damping><friction>0</friction></dynamics>
      </axis></joint><joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>2</effort><velocity>30</velocity></limit>
        <dynamics><damping>0.002</damping><friction>0</friction></dynamics>
      </axis></joint>
  <link name="laser"><pose relative_to="base_link">0.035 0 0.12 0 0 0</pose>
    <inertial><mass>0.1</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00004</izz></inertia></inertial>
    <collision name="lidar_housing_collision"><pose>0 0 -.018 0 0 0</pose><geometry><cylinder><radius>0.026</radius><length>0.025</length></cylinder></geometry></collision><visual name="lidar_housing_visual"><pose>0 0 -.018 0 0 0</pose><geometry><cylinder><radius>0.026</radius><length>0.025</length></cylinder></geometry><material><ambient>.12 .15 .19 1</ambient><diffuse>.12 .15 .19 1</diffuse></material></visual>
    <sensor name="c1_like_lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose><topic>/scan</topic><gz_frame_id>laser</gz_frame_id>
      <always_on>true</always_on><update_rate>10</update_rate><visualize>true</visualize>
      <!-- An idealized 720-ray approximation, not a calibrated C1 digital twin. -->
      <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution>
        <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal></scan>
        <range><min>0.05</min><max>12</max><resolution>0.001</resolution></range>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </link>
  <joint name="laser_fixed_joint" type="fixed"><parent>base_link</parent><child>laser</child></joint>
  <link name="camera_link"><pose relative_to="base_link">0.12 0 0.10 0 0 0</pose>
    <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
    <collision name="camera_housing_collision"><pose>0 0 0 0 0 0</pose><geometry><box><size>.025 .045 .025</size></box></geometry></collision><visual name="camera_housing_visual"><pose>0 0 0 0 0 0</pose><geometry><box><size>.025 .045 .025</size></box></geometry>
      <material><ambient>.11 .12 .13 1</ambient><diffuse>.11 .12 .13 1</diffuse></material></visual>
    <!-- Gazebo renders along camera_link +X. ROS header uses the optical frame. -->
    <sensor name="rgb_camera" type="camera">
      <topic>/camera/image_raw</topic><gz_frame_id>camera_optical_frame</gz_frame_id>
      <always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize>
      <camera><horizontal_fov>1.0471975511965976</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.03</near><far>12</far></clip>
        <camera_info_topic>/camera/camera_info</camera_info_topic><optical_frame_id>camera_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </link>
  <joint name="camera_fixed_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
  <frame name="camera_optical_frame" attached_to="camera_link"><pose relative_to="camera_link">0 0 0 -1.5707963267948966 0 -1.5707963267948966</pose></frame>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>front_left_wheel_joint</left_joint><left_joint>rear_left_wheel_joint</left_joint>
    <right_joint>front_right_wheel_joint</right_joint><right_joint>rear_right_wheel_joint</right_joint>
    <wheel_separation>0.21</wheel_separation><wheel_radius>0.033</wheel_radius>
    <topic>/sim/cmd_vel</topic><odom_publish_frequency>20</odom_publish_frequency>
    <!-- NEVER bridge these wheel-integration outputs into the operational stack. -->
    <odom_topic>/sim/wheel_odom</odom_topic><tf_topic>/sim/wheel_tf</tf_topic>
    <frame_id>sim_wheel_odom</frame_id><child_frame_id>sim_wheel_base</child_frame_id>
    <min_linear_velocity>-0.12</min_linear_velocity><max_linear_velocity>0.12</max_linear_velocity>
    <min_angular_velocity>-0.5</min_angular_velocity><max_angular_velocity>0.5</max_angular_velocity>
    <min_linear_acceleration>-0.3</min_linear_acceleration><max_linear_acceleration>0.3</max_linear_acceleration>
    <min_angular_acceleration>-1.0</min_angular_acceleration><max_angular_acceleration>1.0</max_angular_acceleration>
  </plugin>
  <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <!-- True model pose. Evaluation ONLY; never remap to /odom or bridge its TF. -->
    <odom_frame>sim_world</odom_frame><robot_base_frame>base_link</robot_base_frame><dimensions>2</dimensions>
    <odom_publish_frequency>20</odom_publish_frequency><odom_topic>/sim/odom</odom_topic>
    <odom_covariance_topic>/sim/odom_covariance</odom_covariance_topic><tf_topic>/sim/ground_truth_tf</tf_topic>
  </plugin>
</model></sdf>
