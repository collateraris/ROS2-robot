<?xml version="1.0"?>
<package format="3">
  <name>room_sim</name><version>5.0.0</version>
  <description>Gazebo Harmonic room, encoderless RF2O navigation and a simulation-only drive gate.</description>
  <maintainer email="robot@example.invalid">Room robot project</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend><exec_depend>ros_gz_bridge</exec_depend><exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>room_nav</exec_depend><exec_depend>room_base</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend><exec_depend>nav2_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
