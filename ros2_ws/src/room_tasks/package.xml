<?xml version="1.0"?>
<package format="3">
  <name>room_tasks</name><version>5.0.0</version>
  <description>Strict symbolic local-model planner and Nav2 task coordinator.</description>
  <maintainer email="robot@example.invalid">Room robot project</maintainer><license>MIT</license>
  <exec_depend>rclpy</exec_depend><exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>nav2_msgs</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend><exec_depend>python3-pil</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
